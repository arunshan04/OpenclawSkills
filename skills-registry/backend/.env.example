# Copy to .env and fill in your values
# Provider priority: OLLAMA_HOST → DEEPSEEK_API_KEY → ANTHROPIC_API_KEY

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option 1: DeepSeek (fast, cost-effective; used when OLLAMA_HOST is not set)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODEL=deepseek-chat   # default; deepseek-reasoner for R1 reasoning

# Option 2: Ollama (takes priority over DeepSeek when set)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2   # default; change to mistral, qwen2.5, etc.

# Option 3: Anthropic (fallback when neither Ollama nor DeepSeek is configured)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=skills.db
