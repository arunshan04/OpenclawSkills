# Copy to .env and fill in your values

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option 1: Anthropic (default when OLLAMA_HOST is not set)
ANTHROPIC_API_KEY=your-api-key-here

# Option 2: Ollama (takes priority over Anthropic when set)
# OLLAMA_HOST=https://headstone-alias-blandness.ngrok-free.dev
# OLLAMA_MODEL=llama3.2   # default; change to mistral, qwen2.5, etc.

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=skills.db
